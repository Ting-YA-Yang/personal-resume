---
import { BriefcaseBusiness, Code2, Mail } from 'lucide-react';
import { copy, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
---

<footer class="site-footer" id="contact">
  <div>
    <p class="footer-heading">{locale === 'zh' ? '保持联系' : 'Stay in touch'}</p>
    <a class="footer-email" href="mailto:hello@example.com">hello@example.com</a>
  </div>
  <div class="footer-meta">
    <div class="social-links" aria-label={locale === 'zh' ? '社交链接' : 'Social links'}>
      <a href="https://github.com/Ting-YA-Yang" aria-label="GitHub" title="GitHub"><Code2 size={19} /></a>
      <a href="https://www.linkedin.com/" aria-label="LinkedIn" title="LinkedIn"><BriefcaseBusiness size={19} /></a>
      <a href="mailto:hello@example.com" aria-label="Email" title="Email"><Mail size={19} /></a>
    </div>
    <p>{t.footerLine}</p>
    <p>© {new Date().getFullYear()} Ting-Ya Yang</p>
  </div>
</footer>
