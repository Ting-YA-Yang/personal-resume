---
import { ArrowUpRight } from 'lucide-react';
import { copy, withBase, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  summary: string;
  role: string;
  period: string;
  technologies: string[];
  slug: string;
}

const { locale, title, summary, role, period, technologies, slug } = Astro.props;
const href = locale === 'zh' ? `/projects/${slug}/` : `/en/projects/${slug}/`;
const visual = {
  'services-central': { mark: 'SC', domain: locale === 'zh' ? '支付服务' : 'PAYMENT SERVICES' },
  easyfin: { mark: 'EF', domain: locale === 'zh' ? '财务配置' : 'FINANCE CONFIGURATION' },
  'fx-console': { mark: 'FX', domain: locale === 'zh' ? '资金管理' : 'FUND MANAGEMENT' },
}[slug] ?? { mark: title.slice(0, 2).toUpperCase(), domain: locale === 'zh' ? '项目案例' : 'CASE STUDY' };
---

<article class="project-card">
  <a class="project-visual" href={withBase(href)} aria-label={`${copy[locale].viewCase}: ${title}`}>
    <div class="project-identity" aria-hidden="true">
      <span class="project-domain">{visual.domain}</span>
      <strong>{visual.mark}</strong>
      <span class="project-name">{title}</span>
    </div>
  </a>
  <div class="project-copy">
    <div class="project-meta"><span>{role}</span><span>{period}</span></div>
    <h3><a href={withBase(href)}>{title}<ArrowUpRight size={22} /></a></h3>
    <p>{summary}</p>
    <ul class="tag-list" aria-label="Technologies">
      {technologies.map((technology) => <li>{technology}</li>)}
    </ul>
  </div>
</article>
